# Database. Must use an async driver.
DATABASE_URL=postgresql+asyncpg://supplier:supplier@localhost:5432/supplier
CREATE_SCHEMA_ON_STARTUP=true

# External supplier directory.
SUPPLIER_API_BASE_URL=https://directory.example.com
SUPPLIER_API_KEY=
SUPPLIER_API_TIMEOUT_SECONDS=10
SUPPLIER_API_MAX_ATTEMPTS=3

# Enrichment. Leave the key empty to run without it - jobs are marked skipped.
ANTHROPIC_API_KEY=
ENRICHMENT_MODEL=claude-opus-5

# Background worker.
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=5
WORKER_MAX_ATTEMPTS=3
